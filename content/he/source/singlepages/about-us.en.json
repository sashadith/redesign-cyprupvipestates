    {
      "_key": "0f958d0ad8c7",
      "_type": "imageBulletsBlock",
      "image": {
        "alt": "At Cyprus VIP Estates, we are guided by these core values ​​that guide our actions:",
        "_type": "image",
        "asset": {
          "_ref": "image-176848aeb6b7530e3fc294af6f8ff3495d01e278-619x973-png",
          "_type": "reference"
        }
      },
      "title": "Core Values",
      "bullets": [
        {
          "_key": "dbf5727a02e9",
          "title": "Integrity & Transparency",
          "description": "We value open communication and document all agreements in writing to ensure complete clarity for our clients."
        },
        {
          "_key": "3240d796a5e6",
          "title": "Client Focus",
          "description": "Each client receives personalized attention, as this is the only way we can fulfill personal wishes and create long-term satisfaction."
        },
        {
          "_key": "e540d5bc585e",
          "title": "Local Expertise",
          "description": "Our in-depth knowledge of Cypriot regions, laws, and culture ensures you make optimal real estate decisions."
        },
        {
          "_key": "3b6ed5afece3",
          "title": "Excellence & Professionalism",
          "description": "We are committed to the highest quality of service, continuous training, and a flawless presence – both offline and online."
        },
        {
          "_key": "81ec9ecddf36",
          "title": "Sustainability & Responsibility",
          "description": "We consider environmental aspects in every project and work with partners who maintain fair labor and construction practices."
        },
        {
          "_key": "00c4a4d7e361",
          "title": "Innovation & Efficiency",
          "description": "Using the latest technologies (e.g., AI tools, digital document management), we optimize processes and save you time."
        }
      ]
    },
    {
      "_key": "ab6471216d2a",
      "_type": "reviewsFullBlock",
      "title": "What our customers say?",
