    },
    {
      "_key": "3609ad21fc93",
      "_type": "block",
      "style": "normal",
      "children": [
        {
          "_key": "68cf7de9302e",
          "text": "Many international buyers are motivated by more than financial returns. Cyprus attracts families, retirees, entrepreneurs, and remote professionals seeking a high quality of life, favorable climate, safety, and access to international education.",
          "_type": "span",
          "marks": []
        }
      ],
      "markDefs": []
    },
    {
      "_key": "3a80e8a27cc0",
      "_type": "block",
      "style": "normal",
      "children": [
        {
          "_key": "874684c9a10b",
          "text": "",
          "_type": "span",
          "marks": []
        }
      ],
      "markDefs": []
    },
    {
      "_key": "b122b89083c7",
      "_type": "block",
      "style": "normal",
      "children": [
        {
          "_key": "62098bcfadac",
          "text": "Relocation-focused purchases often prioritize residential neighborhoods, healthcare accessibility, infrastructure, privacy, and long-term comfort rather than short-term investment performance alone.",
          "_type": "span",
          "marks": []
        }
      ],
      "markDefs": []
    },
    {
      "_key": "8474afc86fd6",
      "_type": "block",
