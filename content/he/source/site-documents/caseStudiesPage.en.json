    },
    {
      "_key": "842f46927219",
      "_type": "block",
      "style": "h2",
      "children": [
        {
          "_key": "6bc345826b4d",
          "text": "Relocation and Lifestyle-Focused Purchases",
          "_type": "span",
          "marks": []
        }
      ],
      "markDefs": []
    },
    {
      "_key": "6c44473a37a4",
