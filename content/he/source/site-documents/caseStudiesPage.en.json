        }
      ],
      "markDefs": []
    },
    {
      "_key": "5b9bb1f4227f",
      "_type": "block",
      "style": "normal",
      "children": [
        {
          "_key": "02ea5206284d",
          "text": "For international buyers, especially those considering Cyprus for the first time, these examples offer valuable perspective on what to expect throughout the purchasing journey.",
          "_type": "span",
          "marks": []
        }
      ],
      "markDefs": []
    },
    {
      "_key": "5288a1387e76",
