        "_type": "block",
        "style": "normal",
        "children": [
          {
            "_key": "af51affd1df7",
            "text": "After reviewing several European markets and different regions within Cyprus, attention focused on Limassol due to its strong economy, international business community, and active property market.",
            "_type": "span",
            "marks": []
          }
        ],
        "markDefs": []
      },
