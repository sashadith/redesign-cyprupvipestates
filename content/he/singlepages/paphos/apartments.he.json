          "markDefs": []
        },
        {
          "_key": "pdhykwcmqerq",
          "_type": "block",
          "style": "h2",
          "children": [
            {
              "_key": "5g30moeir2vh",
              "text": "מה כדאי לבדוק במתחם",
              "_type": "span",
              "marks": []
            }
          ],
          "markDefs": []
        },
        {
          "_key": "qkamw6pa6bme",
          "_type": "block",
          "style": "normal",
          "children": [
            {
              "_key": "f78u400pf0sz",
              "text": "שווה להסתכל על מה שמחוץ לדירה לא פחות מאשר עליה. גודל הבריכה המשותפת ומספר היחידות שמשתמשות בה, דמי הניהול החודשיים, חניה מקורה או פתוחה, ומחסן. בדירה בקומה עליונה כדאי לבדוק אם הגג שייך לדירה או משותף לכל הבניין.",
              "_type": "span",
              "marks": []
            }
          ],
          "markDefs": []
        }
