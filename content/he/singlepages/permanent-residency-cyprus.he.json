                "_key": "r9xr2geb9evy",
                "_type": "block",
                "style": "normal",
                "children": [
                  {
                    "_key": "ln4qanmhd98u",
                    "text": "רכישות הקשורות לתושבות עשויות להידרש למסמכים נוספים מעבר לרשימה הרגילה, והיא עצמה משתנה לפי אזרחות הרוכש. הרשימה הבסיסית נמצאת ",
                    "_type": "span",
                    "marks": []
                  },
                  {
                    "_key": "13gig8kgi32y",
                    "text": "בעמוד תהליך הרכישה",
                    "_type": "span",
                    "marks": [
                      "rhmxakz936bx"
