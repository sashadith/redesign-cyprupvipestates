          ],
          "markDefs": []
        },
        {
          "_key": "wewwgb3woiwd",
          "_type": "block",
          "style": "normal",
          "children": [
            {
              "_key": "ygd7xrb88npx",
              "text": "פאפוס מציעה את מחירי הפתיחה הנמוכים מבין שני המחוזות שאנחנו מלווים. מספר הפרויקטים שם גדול יותר, מהמתחמים בעיר ועד אזורי הווילות שמצפון לה, ולכן גם הפער הפנימי בין הזול ליקר במחוז רחב.",
              "_type": "span",
              "marks": []
