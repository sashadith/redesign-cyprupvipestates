          "children": [
            {
              "_key": "dcznccgos3qu",
              "text": "לבדוק מרחק מהים לפני מחיר",
              "_type": "span",
              "marks": []
            }
          ],
          "markDefs": []
        },
        {
          "_key": "yxpznh10flf5",
          "_type": "block",
