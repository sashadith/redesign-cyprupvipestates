                    "_type": "link"
                  }
                ]
              }
            ],
            "question": "כמה עולה וילה בקפריסין על הים?"
          },
          {
            "_key": "l1qbughjzf74",
            "answer": [
              {
                "_key": "z4t56xv2xgw1",
                "_type": "block",
                "style": "normal",
                "children": [
                  {
                    "_key": "xgyqaclbdal7",
                    "text": "הכוונה לבית שאין בינו לבין המים מגרש בנוי או כביש ראשי. בית שמשקיף לים ממדרון שני או שלישי נמכר כבית עם נוף לים, וזה תיאור אחר לגמרי.",
                    "_type": "span",
                    "marks": []
                  }
                ],
                "markDefs": []
              }
            ],
            "question": "מה נחשב קו ראשון לים?"
          },
          {
            "_key": "rs9mzpnapbez",
            "answer": [
              {
                "_key": "b3dwf9d5rh1o",
                "_type": "block",
                "style": "normal",
                "children": [
                  {
                    "_key": "mbedneapxoed",
                    "text": "החלק הגדול של ההיצע החדש נמצא בחוף המערבי של האי, במחוז פאפוס. בלימסול הבנייה החדשה בקו הראשון היא בעיקר דירות במגדלים ולא בתים פרטיים.",
                    "_type": "span",
                    "marks": []
                  }
                ],
                "markDefs": []
              }
            ],
            "question": "איפה נמצאות הווילות על הים?"
          },
          {
            "_key": "htd5tfvwtpuu",
            "answer": [
              {
                "_key": "48w62jbecf4y",
                "_type": "block",
                "style": "normal",
                "children": [
                  {
                    "_key": "d1w8gtomgfxj",
                    "text": "לא מעצם קיומו. נוף שמעל מגרש ריק תלוי בייעוד הקרקע ובגובה הבנייה המותרת שם, ואלה נתונים ציבוריים. אפשר לבקש מעורך הדין לבדוק אותם עוד לפני הסכם שמירת נכס.",
                    "_type": "span",
                    "marks": []
                  }
                ],
                "markDefs": []
              }
            ],
            "question": "הנוף לים מובטח לאורך זמן?"
          },
          {
            "_key": "ikhogd1b2yh3",
            "answer": [
              {
                "_key": "59urnszcolgd",
                "_type": "block",
                "style": "normal",
                "children": [
                  {
                    "_key": "7u25v7qy71yb",
                    "text": "כן. לנכסים בקרבת הים יש ביקוש להשכרת נופש בעונה, והתפוסה משתנה לאורך השנה. אנחנו לא מפעילים נכסים להשכרה.",
                    "_type": "span",
                    "marks": []
                  }
                ],
                "markDefs": []
              }
            ],
            "question": "אפשר לקנות בית על הים ולהשכיר אותו?"
          }
        ]
      }
