      "level": 1,
      "style": "normal",
      "children": [
        {
          "_key": "d9aeb3c817a3",
          "text": "מערכת משפטית בטוחה שמיושרת לתקני האיחוד האירופי",
          "_type": "span",
          "marks": []
        }
      ],
      "listItem": "bullet",
      "markDefs": []
    },
    {
      "_key": "3bb1cb17bb0e",
      "_type": "block",
      "level": 1,
      "style": "normal",
      "children": [
        {
          "_key": "964be639d0e7",
          "text": "הטבות מס אטרקטיביות למשקיעי נדל\"ן",
          "_type": "span",
          "marks": []
        }
      ],
      "listItem": "bullet",
      "markDefs": []
    },
    {
