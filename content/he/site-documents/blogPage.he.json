    },
    {
      "_key": "02311e012a57",
      "_type": "block",
      "style": "normal",
      "children": [
        {
          "_key": "51e09c720b5b",
          "text": "פרויקטים חדשים, וילות למשפחות, תושבות דרך השקעה או תשואה מהשכרה לטווח קצר, בכל אחד מהמסלולים האלה היכרות עם השוק היא מה שעושה את ההבדל.",
          "_type": "span",
          "marks": []
        }
      ],
      "markDefs": []
    },
    {
      "_key": "d3d239276f81",
      "_type": "block",
      "style": "normal",
