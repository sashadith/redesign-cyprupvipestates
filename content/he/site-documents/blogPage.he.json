      "_type": "block",
      "level": 1,
      "style": "normal",
      "children": [
        {
          "_key": "bc88f2511fc1",
          "text": "אקלים ים תיכוני נוח ואיכות חיים גבוהה",
          "_type": "span",
          "marks": []
        }
      ],
      "listItem": "bullet",
      "markDefs": []
    },
    {
