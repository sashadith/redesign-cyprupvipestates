      "_key": "fca818ee700f",
      "_type": "block",
      "style": "normal",
      "children": [
        {
          "_key": "faec0c663a17",
          "text": "מיסי נדל\"ן בקפריסין, דיני ירושה, בעלות של מי שאינם תושבים ואיך לבנות את הרכישה ביעילות מבחינת מס.",
          "_type": "span",
          "marks": []
        }
      ],
      "markDefs": []
    },
    {
      "_key": "5ea6f3e17bc3",
      "_type": "block",
