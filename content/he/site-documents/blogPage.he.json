    },
    {
      "_key": "44479dfa29bf",
      "_type": "block",
      "level": 1,
      "style": "normal",
      "children": [
        {
          "_key": "5e7d1f0995ee",
          "text": "מיקום אסטרטגי בין אירופה, המזרח התיכון ואסיה",
          "_type": "span",
          "marks": []
        }
      ],
      "listItem": "bullet",
      "markDefs": []
    },
    {
