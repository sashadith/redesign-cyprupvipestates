      "_type": "block",
      "level": 1,
      "style": "normal",
      "children": [
        {
          "_key": "7e4353bf2b21",
          "text": "ביקוש חזק להשכרה לטווח קצר ולטווח ארוך",
          "_type": "span",
          "marks": []
        }
      ],
      "listItem": "bullet",
      "markDefs": []
    },
    {
