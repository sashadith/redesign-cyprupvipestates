          "marks": []
        }
      ],
      "markDefs": []
    },
    {
      "_key": "fb564e11caa8",
      "_type": "block",
      "style": "normal",
      "children": [
        {
          "_key": "64b1fcd4749b",
          "text": "קפריסין ממשיכה למשוך רוכשים מחו\"ל בזכות:",
          "_type": "span",
          "marks": []
        }
      ],
      "markDefs": []
    },
    {
      "_key": "d1168c409605",
      "_type": "block",
      "style": "normal",
      "children": [
        {
          "_key": "6a0beda382ce",
