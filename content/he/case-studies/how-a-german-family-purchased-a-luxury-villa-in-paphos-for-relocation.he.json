          "children": [
            {
              "_key": "41ab86edf34f",
              "text": "מחפשים נכס יוקרה בקפריסין?",
              "_type": "span",
              "marks": []
            }
          ],
          "markDefs": []
        },
        {
          "_key": "2a09c341edcb",
          "_type": "block",
          "style": "normal",
