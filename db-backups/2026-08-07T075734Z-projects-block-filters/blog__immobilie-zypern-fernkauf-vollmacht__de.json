              "text": "Reservierung",
              "_type": "span",
              "marks": [
                "strong"
              ]
            },
            {
              "_key": "pt9",
              "text": " und Zahlung der Reservierungsgebühr",
              "_type": "span",
              "marks": []
            }
          ],
          "listItem": "bullet",
          "markDefs": []
        },
        {
          "_key": "ptd",
          "_type": "block",
          "level": 1,
          "style": "normal",
          "children": [
            {
              "_key": "ptb",
              "text": "Rechtliche Prüfung",
              "_type": "span",
              "marks": [
                "strong"
              ]
            },
            {
              "_key": "ptc",
              "text": " durch Ihren Anwalt — Titel, Lasten, Genehmigungen",
              "_type": "span",
              "marks": []
            }
          ],
          "listItem": "bullet",
          "markDefs": []
        },
        {
          "_key": "ptg",
          "_type": "block",
          "level": 1,
          "style": "normal",
          "children": [
            {
