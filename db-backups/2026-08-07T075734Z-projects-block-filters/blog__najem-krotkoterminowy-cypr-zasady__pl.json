              "_type": "span",
              "marks": [
                "strong"
              ]
            },
            {
              "_key": "ptc",
              "text": ", które przejęło zadania dawnej Cypryjskiej Organizacji Turystycznej.",
              "_type": "span",
              "marks": []
            }
          ],
          "markDefs": []
        },
