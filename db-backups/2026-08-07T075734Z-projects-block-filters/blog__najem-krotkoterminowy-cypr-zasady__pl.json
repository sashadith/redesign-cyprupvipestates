  "seo": {
    "metaTitle": "Airbnb na Cyprze: rejestracja i zasady dla właścicieli",
    "metaDescription": "Najem krótkoterminowy na Cyprze wymaga rejestracji w ministerstwie turystyki. Wymogi, podatki, zgłaszanie gości i kary sięgające 5 000 € za naruszenia."
  },
  "contentBlocks": [
    {
      "_key": "imp3z",
