          "style": "normal",
          "children": [
            {
              "_key": "pt32",
              "text": "Okres rękojmi minimum 24 miesiące",
              "_type": "span",
              "marks": [
                "strong"
              ]
            },
            {
              "_key": "pt33",
              "text": " od odbioru, wyraźnie obejmujący konstrukcję i hydroizolację",
