              "_type": "link"
            }
          ]
        },
        {
          "_key": "pt6",
          "_type": "block",
          "style": "normal",
          "children": [
            {
              "_key": "pt5",
              "text": "Ten przewodnik ma charakter ogólnoinformacyjny i odzwierciedla stan na podaną datę; ramy prawne zakupów off-plan ewoluują. Nie jest to porada prawna. Cyprus VIP Estates to agencja marketingu i doradztwa w nieruchomościach; redakcję umowy, terminy, złożenie w Księdze Wieczystej i gwarancje powinien prowadzić niezależny licencjonowany cypryjski prawnik wybrany przez Ciebie.",
              "_type": "span",
              "marks": [
                "em"
              ]
            }
          ],
          "markDefs": []
        }
      ]
