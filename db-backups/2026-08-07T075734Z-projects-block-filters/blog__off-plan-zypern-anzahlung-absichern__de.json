    {
      "_key": "impq",
      "_type": "textContent",
      "content": [
        {
          "_key": "pt4",
          "_type": "block",
          "style": "normal",
          "children": [
            {
              "_key": "pt0",
              "text": "Wir vermitteln ausschließlich Neubauten lizenzierter zyprischer Bauträger zu Bauträgerpreisen. Zu jedem Projekt sagen wir Ihnen, welche Sicherungen der jeweilige Bauträger üblicherweise akzeptiert — und wo erfahrungsgemäß nichts zu verhandeln ist. ",
              "_type": "span",
              "marks": []
            },
            {
              "_key": "pt2",
              "text": "Persönliche Auswahl anfordern",
              "_type": "span",
              "marks": [
                "pt1"
              ]
            },
            {
              "_key": "pt3",
              "text": ".",
              "_type": "span",
              "marks": []
            }
          ],
          "markDefs": [
