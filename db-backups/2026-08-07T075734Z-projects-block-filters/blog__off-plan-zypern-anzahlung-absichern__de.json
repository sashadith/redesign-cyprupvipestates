              "_type": "link"
            }
          ]
        },
        {
          "_key": "pt6",
          "_type": "block",
          "style": "normal",
          "children": [
            {
              "_key": "pt5",
              "text": "Dieser Leitfaden dient der allgemeinen Information und gibt den Stand zum genannten Datum wieder; die Rechtslage zu Off-Plan-Käufen entwickelt sich. Es handelt sich nicht um Rechtsberatung. Cyprus VIP Estates ist eine Immobilien-Marketing- und Beratungsagentur; Vertragsgestaltung, Fristen, Hinterlegung und Garantien gehören in die Hände eines unabhängigen, von Ihnen selbst gewählten lizenzierten zyprischen Anwalts.",
              "_type": "span",
              "marks": [
                "em"
              ]
            }
          ],
          "markDefs": []
        }
      ]
    }
