        },
        {
          "_key": "pt45",
          "_type": "block",
          "level": 1,
          "style": "normal",
          "children": [
            {
              "_key": "pt44",
              "text": "What is the fee — as a percentage of revenue — and at what occupancy does it pay for itself?",
              "_type": "span",
              "marks": []
            }
          ],
          "listItem": "bullet",
