          ]
        },
        {
          "_key": "pt3t",
          "_type": "block",
          "style": "h2",
          "children": [
            {
              "_key": "pt3s",
              "text": "Managing a Cyprus Short-Term Rental From Abroad",
              "_type": "span",
              "marks": []
            }
          ],
          "markDefs": []
        },
        {
          "_key": "pt3v",
          "_type": "block",
          "style": "normal",
          "children": [
            {
              "_key": "pt3u",
              "text": "If you don't live in Cyprus, you need someone on the ground. Settle these questions specifically:",
              "_type": "span",
              "marks": []
            }
          ],
          "markDefs": []
        },
        {
          "_key": "pt3x",
          "_type": "block",
          "level": 1,
          "style": "normal",
          "children": [
            {
              "_key": "pt3w",
              "text": "Who files the guest report inside the 24-hour window?",
              "_type": "span",
              "marks": []
            }
          ],
          "listItem": "bullet",
          "markDefs": []
        },
        {
          "_key": "pt3z",
          "_type": "block",
          "level": 1,
          "style": "normal",
          "children": [
            {
              "_key": "pt3y",
              "text": "Who handles cleaning and key handover between stays?",
              "_type": "span",
              "marks": []
            }
          ],
          "listItem": "bullet",
          "markDefs": []
        },
        {
          "_key": "pt41",
          "_type": "block",
          "level": 1,
          "style": "normal",
          "children": [
            {
              "_key": "pt40",
              "text": "Who responds the same day when the air conditioning fails in August?",
              "_type": "span",
              "marks": []
            }
          ],
          "listItem": "bullet",
          "markDefs": []
        },
        {
          "_key": "pt43",
          "_type": "block",
          "level": 1,
          "style": "normal",
          "children": [
            {
              "_key": "pt42",
              "text": "Who tracks the registration renewal date?",
              "_type": "span",
