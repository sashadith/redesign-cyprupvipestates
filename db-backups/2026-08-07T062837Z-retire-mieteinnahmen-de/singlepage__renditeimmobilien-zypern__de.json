              "marks": []
            }
          ],
          "markDefs": []
        },
        {
          "_key": "pt-3-wmwglq",
          "_type": "block",
          "style": "normal",
          "children": [
            {
              "_key": "span-3-jfwo8j-t0-t0",
              "text": "Lassen Sie uns Ihre Zielrendite und Ihren Anlagehorizont besprechen: Wir entwerfen einen Portfolio-Vorschlag mit konkreten Objekten und einer Netto-Renditerechnung – als belastbare Grundlage für Ihre erste oder nächste Einheit auf Zypern.",
              "_type": "span",
              "marks": []
            }
          ],
          "markDefs": []
        },
        {
          "_key": "blk-de-cs3-ap62sd",
          "_type": "block",
          "style": "normal",
          "children": [
